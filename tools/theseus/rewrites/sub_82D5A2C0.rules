# 64 slots at 0x4000C000 (mask 63: the multiplier matters, 0x9E3779B1 is 1 mod 8
# but 49 mod 64), slot 63 always empty so every probe ends; the others are empty
# or hold keys 16/32/48 (r4 is 0..63: hits and misses, several start slots).
r3 ptr
r4 len 63
mem32 @r3+0 fixed 0x4000C000
mem32 @r3+8 fixed 63
mem32 0x4000c000 oneof 0xFFFFFFFF 16 32 48
