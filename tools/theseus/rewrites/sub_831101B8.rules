# r3+8 flags random (opcode bits 7..13 hit 83..95 ~10%), r3+0 sometimes 0;
# r3+4 = a list of up to 3 nodes at 0x4000C000/+0x40/+0x80 linked by +8,
# each node's +16 is 0 or 1 and its +0 flags pass the mask test ~10% of the time.
r3 ptr
mem32 @r3+8 u32
mem32 @r3+0 ptr_or_null
mem32 @r3+4 fixed_or_null 0x4000C000
mem32 0x4000c008 fixed_or_null 0x4000c040
mem32 0x4000c010 len 1
mem32 0x4000c000 len 0x4FFFFFFF
mem32 0x4000c048 fixed_or_null 0x4000c080
mem32 0x4000c050 len 1
mem32 0x4000c040 len 0x4FFFFFFF
mem32 0x4000c088 fixed 0
mem32 0x4000c090 len 1
mem32 0x4000c080 len 0x4FFFFFFF
